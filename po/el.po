msgstr "Αδύνατη η ρύθμιση της λίστας κρυπτογράφησης TLS: %s"

#: tls/openssl/gtlsclientconnection-openssl.c:365
#: tls/openssl/gtlsserverconnection-openssl.c:320
#, c-format
msgid "Could not set MAX protocol to %d: %s"
msgstr "Αδυναμία ορισμού MAX πρωτοκόλλου σε %d: %s"

#: tls/openssl/gtlsclientconnection-openssl.c:437
#: tls/openssl/gtlsserverconnection-openssl.c:371
#, c-format
msgid "Could not create TLS session: %s"
msgstr "Δεν ήταν δυνατή η δημιουργία συνεδρίας TLS: %s"

#: tls/openssl/gtlsclientconnection-openssl.c:454
#: tls/openssl/gtlsserverconnection-openssl.c:383
#, c-format
msgid "Could not create TLS context: %s"
msgstr "Αδυναμία δημιουργίας πλαισίου TLS: %s"

#: tls/openssl/gtlsconnection-openssl.c:191
msgid "Unacceptable TLS certificate authority"
msgstr "Μη αποδεκτή αρχή έκδοσης πιστοποιητικών TLS"

#: tls/openssl/gtlsconnection-openssl.c:198
msgid "Digest too big for RSA key"
msgstr "Το digest είναι πολύ μεγάλο για το κλειδί RSA"

#: tls/openssl/gtlsconnection-openssl.c:241
#, c-format
msgid "%s: The connection is broken"
msgstr "%s: Η σύνδεση είναι σπασμένη"

#: tls/openssl/gtlsconnection-openssl.c:641
msgid "The request is invalid."
msgstr "Το αίτημα είναι μη έγκυρο."

#: tls/openssl/gtlsconnection-openssl.c:663
msgid "Channel binding data tls-unique is not available"
msgstr "Τα δεδομένα σύνδεσης καναλιού tls-unique δεν είναι διαθέσιμα"

#: tls/openssl/gtlsconnection-openssl.c:686
msgid "X.509 Certificate is not available on the connection"
msgstr "Το πιστοποιητικό X.509 δεν είναι διαθέσιμο στη σύνδεση"

#: tls/openssl/gtlsconnection-openssl.c:695
msgid "Unable to obtain certificate signature algorithm"
msgstr "Αδυναμία λήψης αλγορίθμου υπογραφής πιστοποιητικού"

#: tls/openssl/gtlsconnection-openssl.c:715
msgid ""
"Current X.509 certificate uses unknown or unsupported signature algorithm"
msgstr ""
"Το τρέχον πιστοποιητικό X.509 χρησιμοποιεί άγνωστο ή μη υποστηριζόμενο "
"αλγόριθμο υπογραφής"

#: tls/openssl/gtlsconnection-openssl.c:733
msgid "Failed to generate X.509 certificate digest"
msgstr "Αποτυχία δημιουργίας digest πιστοποιητικού X.509"

#: tls/openssl/gtlsconnection-openssl.c:764
msgid "TLS Connection does not support TLS-Exporter feature"
msgstr "Η σύνδεση TLS δεν υποστηρίζει τη λειτουργία TLS-Exporter"

#: tls/openssl/gtlsconnection-openssl.c:767
msgid "Unexpected error while exporting keying data"
msgstr "Απροσδόκητο σφάλμα κατά την εξαγωγή δεδομένων κλειδιού"

#: tls/openssl/gtlsconnection-openssl.c:1045
msgid "Error performing TLS close"
msgstr "Σφάλμα κατά την εκτέλεση κλεισίματος TLS"

#: tls/openssl/gtlsdatabase-openssl.c:176
msgid "Could not get trust settings for certificate"
msgstr "Αδυναμία λήψης ρυθμίσεων εμπιστοσύνης για το πιστοποιητικό"

#: tls/openssl/gtlsdatabase-openssl.c:264
msgid "Could not retrieve certificates"
msgstr "Αδυναμία ανάκτησης πιστοποιητικών"

#: tls/openssl/gtlsdatabase-openssl.c:364
msgid "Could not get root certificate store"
msgstr "Αδυναμία λήψης αποθήκης ριζικών πιστοποιητικών"

#: tls/openssl/gtlsdatabase-openssl.c:371
msgid "Could not get CA certificate store"
msgstr "Αδυναμία λήψης αποθήκης πιστοποιητικών CA"

#: tls/openssl/gtlsdatabase-openssl.c:437
msgid "Could not create CA store"
msgstr "Αδυναμία δημιουργίας αποθήκης CA"

#: tls/openssl/gtlsserverconnection-openssl.c:186
#, c-format
msgid "There is a problem with the certificate: %s"
msgstr "Υπάρχει πρόβλημα με το πιστοποιητικό: %s"

#: tls/openssl/gtlsserverconnection-openssl.c:195
#, c-format
msgid "There is a problem with the certificate private key: %s"
msgstr "Υπάρχει πρόβλημα με το ιδιωτικό κλειδί του πιστοποιητικού: %s"

#: tls/openssl/gtlsserverconnection-openssl.c:204
#, c-format
msgid "There was a problem clearing the chain certificates: %s"
msgstr ""
"Παρουσιάστηκε πρόβλημα κατά την εκκαθάριση των πιστοποιητικών της αλυσίδας: "
"%s"

#: tls/openssl/gtlsserverconnection-openssl.c:225
#, c-format
msgid "There was a problem adding the chain certificate: %s"
msgstr ""
"Παρουσιάστηκε πρόβλημα κατά την προσθήκη του πιστοποιητικού αλυσίδας: %s"

