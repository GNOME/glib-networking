msgstr "เกิดข้อผิดพลาดขณะเขียนข้อมูลลงซ็อกเก็ต TLS"

#: tls/gnutls/gtlsconnection-gnutls.c:1366
#, c-format
msgid "Message of size %lu byte is too large for DTLS connection"
msgid_plural "Message of size %lu bytes is too large for DTLS connection"
msgstr[0] "ข้อความขนาด %lu ไบต์ใหญ่เกินไปสำหรับการเชื่อมต่อ DTLS"

#: tls/gnutls/gtlsconnection-gnutls.c:1368
#, c-format
msgid "(maximum is %u byte)"
msgid_plural "(maximum is %u bytes)"
msgstr[0] "(ค่าสูงสุดอยู่ที่ %u ไบต์)"

#: tls/gnutls/gtlsconnection-gnutls.c:1415
#, c-format
