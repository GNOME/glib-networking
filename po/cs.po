msgid "There was a problem clearing the chain certificates: %s"
msgstr "Je zde problém s odebráním řetězového certifikátu: %s"

#: tls/openssl/gtlsserverconnection-openssl.c:225
#, c-format
msgid "There was a problem adding the chain certificate: %s"
msgstr "Je zde problém s přidáním řetězového certifikátu: %s"

