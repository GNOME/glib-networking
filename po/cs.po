msgstr "Nezdařilo se získat úložiště certifikátu CA"

#: tls/openssl/gtlsdatabase-openssl.c:434
msgid "Could not create CA store"
msgstr "Nezdařilo se vytvořit úložiště CA"

#: tls/openssl/gtlsserverconnection-openssl.c:186
#, c-format
msgid "There is a problem with the certificate: %s"
msgstr "Je zde problém s certifikátem: %s"

#: tls/openssl/gtlsserverconnection-openssl.c:195
