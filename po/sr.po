#: tls/gnutls/gtlsconnection-gnutls.c:1323
#, c-format
msgid "Message of size %lu byte is too large for DTLS connection"
msgid_plural "Message of size %lu bytes is too large for DTLS connection"
msgstr[0] "Порука величине %lu бајта је превелика за ДТЛС везу"
msgstr[1] "Порука величине %lu бајта је превелика за ДТЛС везу"
msgstr[2] "Порука величине %lu бајтова је превелика за ДТЛС везу"
msgstr[3] "Порука величине %lu бајта је превелика за ДТЛС везу"

#: tls/gnutls/gtlsconnection-gnutls.c:1325
#, c-format
msgid "(maximum is %u byte)"
msgid_plural "(maximum is %u bytes)"
msgstr[0] "(највише %u бајт)"
msgstr[1] "(највише %u бајта)"
msgstr[2] "(највише %u бајтова)"
msgstr[3] "(највише %u бајт)"

#: tls/gnutls/gtlsconnection-gnutls.c:1372
#, c-format
msgid "Error performing TLS close: %s"
msgstr "Грешка приликом затварања ТЛС-а: %s"

#: tls/gnutls/gtlsdatabase-gnutls.c:91
#, c-format
msgid "Failed to allocate credentials: %s"
msgstr "Не могу да захватим акредитиве: %s"

#: tls/gnutls/gtlsdatabase-gnutls.c:593
msgid ""
"Failed to load system trust store: GnuTLS was not configured with a system "
