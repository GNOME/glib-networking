msgstr "Не могу да подесим највиши протокол на %d: %s"

#: tls/openssl/gtlsclientconnection-openssl.c:437
#: tls/openssl/gtlsserverconnection-openssl.c:371
#, c-format
msgid "Could not create TLS session: %s"
msgstr "Не могу да направим ТЛС сесију: %s"

#: tls/openssl/gtlsclientconnection-openssl.c:454
#: tls/openssl/gtlsserverconnection-openssl.c:383
#, c-format
msgid "Could not create TLS context: %s"
msgstr "Не могу да направим ТЛС контекст: %s"

#: tls/openssl/gtlsconnection-openssl.c:190
msgid "Unacceptable TLS certificate authority"
msgstr "Неприхватљиво ТЛС сертификационо тело"

#: tls/openssl/gtlsconnection-openssl.c:197
msgid "Digest too big for RSA key"
msgstr "Сажетак је превелик за РСА кључ"

#: tls/openssl/gtlsconnection-openssl.c:240
#, c-format
msgid "%s: The connection is broken"
msgstr "%s: веза је прекинута"

#: tls/openssl/gtlsconnection-openssl.c:618
msgid "The request is invalid."
msgstr "Захтев је неисправан."

#: tls/openssl/gtlsconnection-openssl.c:640
msgid "Channel binding data tls-unique is not available"
msgstr "Подаци свезивања канала „tls-unique“ нису доступни"

#: tls/openssl/gtlsconnection-openssl.c:663
msgid "X.509 Certificate is not available on the connection"
msgstr "X.509 уверење није доступно на вези"

#: tls/openssl/gtlsconnection-openssl.c:672
msgid "Unable to obtain certificate signature algorithm"
msgstr "Не могу да добијем алгоритам потписа уверења"

#: tls/openssl/gtlsconnection-openssl.c:692
msgid ""
"Current X.509 certificate uses unknown or unsupported signature algorithm"
msgstr "Тренутно X.509 уверење користи непознат или неподржани алгоритам потписа"

#: tls/openssl/gtlsconnection-openssl.c:710
msgid "Failed to generate X.509 certificate digest"
msgstr "Нисам успео да генеришем сажетак X.509 уверења"

#: tls/openssl/gtlsconnection-openssl.c:741
msgid "TLS Connection does not support TLS-Exporter feature"
msgstr "ТЛС веза не подржава функцију ТЛС извозника"

#: tls/openssl/gtlsconnection-openssl.c:744
msgid "Unexpected error while exporting keying data"
msgstr "Неочекивана грешка приликом извоза података кључевања"

#: tls/openssl/gtlsconnection-openssl.c:1022
msgid "Error performing TLS close"
msgstr "Грешка при затварању ТЛС везе"

#: tls/openssl/gtlsdatabase-openssl.c:174
msgid "Could not get trust settings for certificate"
msgstr "Не могу да добавим подешавања поверења за уверење"

#: tls/openssl/gtlsdatabase-openssl.c:261
msgid "Could not retrieve certificates"
msgstr "Не могу да добавим уверења"

#: tls/openssl/gtlsdatabase-openssl.c:361
