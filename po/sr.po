msgstr "Не могу да добавим складиште корених уверења"

#: tls/openssl/gtlsdatabase-openssl.c:368
msgid "Could not get CA certificate store"
msgstr "Не могу да добавим складиште уверења сертификационог тела"

#: tls/openssl/gtlsdatabase-openssl.c:434
msgid "Could not create CA store"
msgstr "Не могу да направим складиште издавача уверења"

#: tls/openssl/gtlsserverconnection-openssl.c:186
#, c-format
msgid "There is a problem with the certificate: %s"
msgstr "Постоји проблем са уверењем: %s"

#: tls/openssl/gtlsserverconnection-openssl.c:195
#, c-format
msgid "There is a problem with the certificate private key: %s"
msgstr "Постоји проблем са приватним кључем уверења: %s"

#: tls/openssl/gtlsserverconnection-openssl.c:204
#, c-format
msgid "There was a problem clearing the chain certificates: %s"
msgstr "Настао је проблем при чишћењу ланца уверења: %s"

#: tls/openssl/gtlsserverconnection-openssl.c:225
#, c-format
msgid "There was a problem adding the chain certificate: %s"
msgstr "Настао је проблем при додавању ланца уверења: %s"
