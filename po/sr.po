msgstr "Нису обезбеђени подаци уверења"

#: tls/gnutls/gtlscertificate-gnutls.c:983
#: tls/gnutls/gtlsconnection-gnutls.c:1014
#, c-format
msgid "Cannot verify peer identity of unexpected type %s"
msgstr "Не могу да потврдим идентитет парњака неочекиване врсте „%s“"

#: tls/gnutls/gtlsconnection-gnutls.c:214
#: tls/gnutls/gtlsconnection-gnutls.c:224
msgid "Could not create TLS connection:"
msgstr "Не могу да направим ТЛС везу:"

#: tls/gnutls/gtlsconnection-gnutls.c:244
#: tls/openssl/gtlsclientconnection-openssl.c:503
#: tls/openssl/gtlsserverconnection-openssl.c:418
#, c-format
msgid "Could not create TLS connection: %s"
msgstr "Не могу да направим ТЛС везу: %s"

#: tls/gnutls/gtlsconnection-gnutls.c:436
#: tls/gnutls/gtlsconnection-gnutls.c:445
#: tls/gnutls/gtlsconnection-gnutls.c:455
#: tls/openssl/gtlsconnection-openssl.c:158
#, c-format
msgid "Peer failed to perform TLS handshake: %s"
msgstr "Парњак није успео да изврши ТЛС руковање: %s"

#: tls/gnutls/gtlsconnection-gnutls.c:462
#: tls/openssl/gtlsconnection-openssl.c:207
msgid "TLS connection closed unexpectedly"
msgstr "ТЛС веза је неочекивано затворена"

#: tls/gnutls/gtlsconnection-gnutls.c:477
#: tls/openssl/gtlsconnection-openssl.c:176
msgid "TLS connection peer did not send a certificate"
msgstr "Парњак ТЛС везе није послао уверење"

#: tls/gnutls/gtlsconnection-gnutls.c:491
#, c-format
msgid "Peer sent fatal TLS alert: %s"
msgstr "Парњак је послао кобно ТЛС упозорење: %s"

#: tls/gnutls/gtlsconnection-gnutls.c:500
msgid "Protocol version downgrade attack detected"
msgstr "Уочен је напад уназађивања издања протокола"

#: tls/gnutls/gtlsconnection-gnutls.c:508
#, c-format
msgid "Message is too large for DTLS connection; maximum is %u byte"
msgid_plural "Message is too large for DTLS connection; maximum is %u bytes"
msgstr[0] "Порука је превелика за ДТЛС везу, највише је дозвољен %u бајт"
msgstr[1] "Порука је превелика за ДТЛС везу, највише је дозвољено %u бајта"
msgstr[2] "Порука је превелика за ДТЛС везу, највише је дозвољено %u бајтова"
msgstr[3] "Порука је превелика за ДТЛС везу, највише је дозвољен %u бајт"

#: tls/gnutls/gtlsconnection-gnutls.c:516
msgid "The operation timed out"
msgstr "Време извршавања радње је истекло"

#: tls/gnutls/gtlsconnection-gnutls.c:940
msgid "Error performing TLS handshake"
msgstr "Грешка у извршавању ТЛС руковања"

#: tls/gnutls/gtlsconnection-gnutls.c:1113
#, c-format
msgid ""
"Empty channel binding data indicates a bug in the TLS library implementation"
msgstr "Празни подаци увезивања канала указују на грешку у изради ТЛС библиотеке"

#: tls/gnutls/gtlsconnection-gnutls.c:1131
#, c-format
msgid "Channel binding type is not implemented in the TLS library"
msgstr "Врста увезивања канала није израђена у ТЛС библиотеци"

#: tls/gnutls/gtlsconnection-gnutls.c:1135
#, c-format
msgid "Channel binding data is not yet available"
msgstr "Подаци увезивања канала још нису доступни"

#: tls/gnutls/gtlsconnection-gnutls.c:1187
#: tls/openssl/gtlsconnection-openssl.c:768
#, c-format
msgid "Requested channel binding type is not implemented"
msgstr "Захтевана врста свезивања канала није примењена"

#: tls/gnutls/gtlsconnection-gnutls.c:1208
#: tls/gnutls/gtlsconnection-gnutls.c:1268
#: tls/openssl/gtlsconnection-openssl.c:786
#: tls/openssl/gtlsconnection-openssl.c:882
