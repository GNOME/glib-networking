#: tls/gnutls/gtlscertificate-gnutls.c:522
#: tls/openssl/gtlscertificate-openssl.c:543
#, c-format
msgid "Could not parse DER certificate: %s"
msgstr "Не могу да обрадим ДЕР уверење: %s"

#: tls/gnutls/gtlscertificate-gnutls.c:543
#: tls/openssl/gtlscertificate-openssl.c:569
#, c-format
msgid "Could not parse PEM certificate: %s"
msgstr "Не могу да обрадим ПЕМ уверење: %s"

#: tls/gnutls/gtlscertificate-gnutls.c:566
#: tls/openssl/gtlscertificate-openssl.c:594
#, c-format
msgid "Could not parse DER private key: %s"
msgstr "Не могу да обрадим приватни ДЕР кључ: %s"

#: tls/gnutls/gtlscertificate-gnutls.c:589
#: tls/openssl/gtlscertificate-openssl.c:619
#, c-format
msgid "Could not parse PEM private key: %s"
msgstr "Не могу да обрадим приватни ПЕМ кључ: %s"

#: tls/gnutls/gtlscertificate-gnutls.c:615
#, c-format
msgid "Could not import PKCS #11 certificate URI: %s"
msgstr "Не могу да увезем адресу уверења ПКЦС #11: %s"

#: tls/gnutls/gtlscertificate-gnutls.c:659
#: tls/openssl/gtlscertificate-openssl.c:657
