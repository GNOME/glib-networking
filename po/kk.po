#: tls/openssl/gtlsserverconnection-openssl.c:204
#, c-format
msgid "There was a problem clearing the chain certificates: %s"
msgstr "Тізбек сертификаттарын тазарту кезінде мәселе туындады: %s"

#: tls/openssl/gtlsserverconnection-openssl.c:225
#, c-format
