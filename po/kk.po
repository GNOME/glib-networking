#: tls/gnutls/gtlscertificate-gnutls.c:983
#: tls/gnutls/gtlsconnection-gnutls.c:1014
#, c-format
msgid "Cannot verify peer identity of unexpected type %s"
msgstr "Торап шынайылығын растау мүмкін емес, оның түрі күтілмеген %s"

